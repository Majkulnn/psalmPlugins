{
  "name": "majkuln/psalm-plugins",
  "description": "A collection of plugins extending Psalm static analysis.",
  "type": "project",
  "require": {
    "php": ">=8.5 <8.6",
    "friendsofphp/php-cs-fixer": "^3.0"
  },
  "require-dev": {
    "vimeo/psalm": "^6.11"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {}
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}