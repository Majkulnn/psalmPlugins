{
  "name": "majkuln/psalm-plugins",
  "description": "A collection of plugins extending Psalm static analysis.",
  "type": "project",
  "require": {
    "php": ">=8.5 <8.6",
    "ext-simplexml": "*"
  },
  "require-dev": {
    "doctrine/collections": "^3.1",
    "doctrine/orm": "^3.7",
    "friendsofphp/php-cs-fixer": "^3.0",
    "phpunit/phpunit": "^13.3",
    "vimeo/psalm": "^6.11"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {}
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
